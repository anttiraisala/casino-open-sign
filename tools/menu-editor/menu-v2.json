{
  "format": 1,
  "name": "Casino Open Sign V2 settings menu",
  "common": {
    "types": {
      "level255": {
        "kind": "int",
        "min": 0,
        "max": 255
      },
      "speed": {
        "kind": "float",
        "scale": "log",
        "min": 0.125,
        "max": 4,
        "steps": 30,
        "default": 1,
        "decimals": 3,
        "unit": "x"
      },
      "exponent": {
        "kind": "float",
        "scale": "log",
        "min": 0.1,
        "max": 20,
        "steps": 50,
        "default": 2.67,
        "decimals": 2
      },
      "yesno": {
        "kind": "bool",
        "trueText": "Yes",
        "falseText": "No"
      },
      "readOnlySwitch": {
        "readOnly": true,
        "persist": false
      },
      "mix": {
        "kind": "float",
        "scale": "linear",
        "min": 0,
        "max": 1,
        "steps": 50,
        "default": 1,
        "decimals": 2
      }
    },
    "properties": {
      "program": {
        "name": "Program",
        "kind": "int",
        "type": "readOnlySwitch",
        "min": 0,
        "max": 15,
        "default": 0,
        "format": "hex",
        "bind": "D34-D37 program switch"
      },
      "arrow": {
        "name": "Arrow",
        "kind": "choice",
        "type": "readOnlySwitch",
        "choices": [
          "Left",
          "Right"
        ],
        "bind": "D32 arrow switch"
      },
      "casino": {
        "name": "Casino",
        "kind": "choice",
        "type": "readOnlySwitch",
        "choices": [
          "Closed",
          "Open"
        ],
        "bind": "D30 casino switch"
      },
      "arrowReverse": {
        "name": "Arrow reverse",
        "type": "yesno",
        "callbacks": [
          "applySwitches"
        ]
      },
      "casinoReverse": {
        "name": "Casino reverse",
        "type": "yesno",
        "callbacks": [
          "applySwitches"
        ]
      },
      "speedFrame": {
        "name": "Frame",
        "type": "speed",
        "callbacks": [
          "applySpeeds"
        ]
      },
      "speedArrow": {
        "name": "Arrow",
        "type": "speed",
        "callbacks": [
          "applySpeeds"
        ]
      },
      "speedLetters": {
        "name": "Letters",
        "type": "speed",
        "callbacks": [
          "applySpeeds"
        ]
      },
      "randomDelay": {
        "name": "Change delay",
        "kind": "int",
        "min": 0,
        "max": 30,
        "default": 2,
        "unit": " min",
        "valueTexts": {
          "0": "random"
        }
      },
      "stripMin": {
        "name": "Min",
        "type": "level255",
        "default": 0,
        "callbacks": [
          "rebuildStripCurve"
        ]
      },
      "stripMax": {
        "name": "Max",
        "type": "level255",
        "default": 80,
        "callbacks": [
          "rebuildStripCurve"
        ]
      },
      "stripExp": {
        "name": "Exponent",
        "type": "exponent",
        "callbacks": [
          "rebuildStripCurve"
        ]
      },
      "stickMin": {
        "name": "Min",
        "type": "level255",
        "default": 0,
        "callbacks": [
          "rebuildStickCurve"
        ]
      },
      "stickMax": {
        "name": "Max",
        "type": "level255",
        "default": 80,
        "callbacks": [
          "rebuildStickCurve"
        ]
      },
      "stickExp": {
        "name": "Exponent",
        "type": "exponent",
        "callbacks": [
          "rebuildStickCurve"
        ]
