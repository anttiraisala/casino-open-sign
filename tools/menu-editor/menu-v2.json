{
  "format": 1,
  "name": "Casino Open Sign V2 settings menu",
  "common": {
    "types": {
      "level255": {
        "kind": "int",
        "min": 0,
        "max": 255
      },
      "speed": {
        "kind": "float",
        "scale": "log",
        "min": 0.125,
        "max": 4,
        "steps": 30,
        "default": 1,
        "decimals": 3,
        "unit": "x"
      },
      "exponent": {
        "kind": "float",
        "scale": "log",
        "min": 0.1,
        "max": 20,
        "steps": 50,
        "default": 2.67,
        "decimals": 2
      },
      "yesno": {
        "kind": "bool",
        "trueText": "Yes",
        "falseText": "No"
      },
      "readOnlySwitch": {
        "readOnly": true,
        "persist": false
      },
      "mix": {
        "kind": "float",
        "scale": "linear",
        "min": 0,
        "max": 1,
        "steps": 50,
        "default": 1,
        "decimals": 2
      }
    },
    "properties": {
      "frameEffect": {
        "name": "Frame effect",
        "kind": "choice",
        "choices": [
          "Random",
          "1 Bar",
          "2 Comet",
          "3 Fill",
          "4 Ignite",
          "5 Sides blink",
          "6 Odd even",
          "7 Ping-pong",
          "8 Twinkle",
          "9 Runner",
          "10 Heartbeat",
          "11 Corners",
          "12 Edges swap",
          "13 Slot machine",
          "14 Twin comets",
          "15 Grey bands"
        ],
        "default": "1 Bar",
        "callbacks": [
          "effectFrameChanged"
        ]
      },
      "lettersEffect": {
        "name": "Letters effect",
        "kind": "choice",
        "choices": [
          "Random",
          "1 Breathe",
          "2 Wave",
          "3 Typewriter",
          "4 Ignite",
          "5 Word blink",
          "6 Alternate",
          "7 Scanner",
          "8 Sparkle",
          "9 Chase",
          "10 Pulse",
          "11 Converge",
          "12 Words swap",
          "13 Slot machine",
          "14 Twin chase",
          "15 Grey bands"
        ],
        "default": "1 Breathe",
        "callbacks": [
          "effectLettersChanged"
        ]
      },
      "arrow": {
        "name": "Arrow",
        "kind": "choice",
        "type": "readOnlySwitch",
        "choices": [
          "Left",
          "Right"
        ],
        "bind": "D32 arrow switch"
      },
